# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Bot Prefix for standard commands (e.g., !meme, !lfg)
BOT_PREFIX=!

# Channel ID for auto welcome message (Optional, leave 0 to auto-detect channel named welcome)
WELCOME_CHANNEL_ID=0

# Default role assigned to new members automatically
AUTO_ROLE_NAME=Gamers
